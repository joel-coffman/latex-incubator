\NeedsTeXFormat{LaTeX2e}
%    \end{macrocode}
% Identify package and version.
%    \begin{macrocode}
\ProvidesPackage{symfoot}[%
    2023/02/07 %
    v0.0.1 %
    Footnotes tnumbered using symbols%
]
%    \end{macrocode}
%
% \section{Counters}
% This section describes the counters in the \textsf{symfoot} package.
%
%    \begin{macrocode}
\newcounter{symfootnote}
\setcounter{symfootnote}{1}
%    \end{macrocode}
%
% \subsection{Macros}
% This section describes the macros in the \textsf{symfoot} package.
%
% \begin{macro}{symfootnote}
%    \begin{macrocode}
\newcommand{\symfootnote}[2][\arabic{symfootnote}]{%
  \stepcounter{symfootnote}%
  \symfootnotemark{#1}%
  \symfootnotetext{#2}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{symfootnotemark}
%    \begin{macrocode}
\newcommand{\symfootnotemark}[1][\arabic{symfootnote}]{%
  \let\oldthefootnote=\thefootnote%
  \setcounter{symfootnote}{#1}%
  \renewcommand{\thefootnote}{%
    \fnsymbol{symfootnote}%
  }%
  \footnotemark[#1]%
  \let\thefootnote=\oldthefootnote%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{symfootnotetext}
%    \begin{macrocode}
\newcommand{\symfootnotetext}[2][\arabic{symfootnote}]{%
  \let\oldthefootnote=\thefootnote%
  \setcounter{symfootnote}{#1}%
  \renewcommand{\thefootnote}{%
    \fnsymbol{symfootnote}%
  }%
  \footnotetext[#1]{#2}%
  \let\thefootnote=\oldthefootnote%
}
%    \end{macrocode}
% \end{macro}
